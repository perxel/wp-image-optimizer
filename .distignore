# Files and folders that must NOT ship in the installable build.

/.git
/.github
/.idea
/.claude
/bin
/dist
/node_modules
/tests

# Maintainer-only UI-kit component showcase - not shipped. ui/loader.php
# tolerates its absence (>= 0.15.0).
/ui/showcase

# UI-kit dev docs (no code references them).
/ui/README.md
/ui/CHANGELOG.md
/ui/CHECKLIST-wordpress-org.md

# Composer dev tooling. Action Scheduler (/vendor/action-scheduler) is a
# runtime dependency and DOES ship — see CLAUDE.md.
/vendor/bin
/vendor/composer
/vendor/autoload.php
/vendor/dealerdirect
/vendor/phpcompatibility
/vendor/phpcsstandards
/vendor/squizlabs
/vendor/wp-coding-standards

.distignore
.gitignore
.editorconfig
CLAUDE.md
README.md
composer.json
composer.lock
phpcs.xml.dist
phpunit.xml.dist
package.json
package-lock.json

{
	"name": "perxel/wp-image-optimizer",
	"description": "Convert the WordPress media library to WebP and serve it via .htaccess. No SSH, no external service.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Perxel",
			"homepage": "https://perxel.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"build": "bin/build-zip.sh"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
